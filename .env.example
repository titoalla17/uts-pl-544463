# Salin ke .env (JANGAN commit .env); ganti semua contoh password.
# APP_KEY: jalankan php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
APP_KEY=
APP_ENV=production
APP_DEBUG=false
