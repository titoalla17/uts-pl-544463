DB_USERNAME=film_user
DB_PASSWORD=GANTI_PASSWORD_DATABASE
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT
DEMO_NAME="Admin UTS"
DEMO_EMAIL=admin@example.test
DEMO_PASSWORD=GANTI_PASSWORD_LOGIN
